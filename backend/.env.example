# Copy to .env for local runs (never commit real values).
APP_ENV=development
PORT=8080
# Supabase (West EU / Paris, eu-west-3) — Transaction pooler, port 6543. Replace [YOUR-PASSWORD];
# percent-encode special characters in it. Pooler mode is detected automatically (DB_TRANSACTION_POOLER to override).
# DATABASE_URL=postgresql://postgres.bualtfdrfvsnnydwtmgz:[YOUR-PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:6543/postgres
# Local Postgres alternative:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/celestial?sslmode=disable
JWT_SECRET=change-me-to-32-random-chars
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
PUBLIC_URL=http://localhost:5173
API_URL=http://localhost:8080

# Stripe (leave empty to run checkout in mock mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (leave empty: emails are logged, not sent)
RESEND_API_KEY=
EMAIL_FROM=Celestial Oud <noreply@celestialoud.com>
ADMIN_EMAILS=

# Shared secret the Worker cron sends on POST /internal/cron/tick
CRON_SECRET=
# Optional UK address lookup
IDEAL_POSTCODES_KEY=
