# Base URL of the Go API (no trailing slash). Leave empty to run against the
# in-browser mock catalogue (useful for design review and local dev).
VITE_API_URL=

# Minimum order value for free UK delivery, in pence (e.g. 5000 = £50).
VITE_FREE_DELIVERY_THRESHOLD=5000

# Public asset host (CDN). Leave empty to serve from the same origin.
VITE_ASSET_BASE=
